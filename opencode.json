{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "Authorization": "Bearer "
            },
            "enabled": true
        },
        "stripe": {
            "type": "remote",
            "url": "https://mcp.stripe.com",
            "headers": {
                "Authorization": "Bearer "
            },
            "enabled": true
        },
        "next-devtools": {
            "command": "bunx",
            "args": ["-y", "next-devtools-mcp@latest"],
            "enabled": true
        }
    }
}
